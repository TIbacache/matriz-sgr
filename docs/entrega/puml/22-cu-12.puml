@startuml 22-cu-12
' CU-12 · Controlar la actividad de usuarios — caso de uso detallado.
' El caso con su actor, sus casos incluidos y sus casos de extensión.
' La explicación de cada paso va en la FICHA, no en el diagrama: la
' rúbrica §5.4 pide el detalle en la ficha textual (casos-uso-detalle.md).
title CU-12 · Controlar la actividad de usuarios

skinparam backgroundColor #F4F4F2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #5B6166
skinparam ArrowFontColor #5B6166
skinparam ArrowFontSize 11
skinparam actorStyle awesome
skinparam actor {
  BackgroundColor #EFEDE8
  BorderColor #5B6166
  FontColor #1A1A1A
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #B9BDBF
  FontColor #1A1A1A
}
skinparam rectangle {
  BackgroundColor #FAFAF8
  BorderColor #B9BDBF
  FontColor #5B6166
}

actor "Administrador" as ADM
actor "Coordinador\ndel sistema" as COO

rectangle "**SGR** — M4 · Cálculos y tableros" #FFFFFF {
  usecase "CU-12\nControlar la actividad\nde usuarios" as CU12
  usecase "CU-E5\nDenegar por alcance\ncon el motivo escrito" as CUE5
  usecase "CU-I3\nRegistrar en la bitácora\nde auditoría" as CUI3
}

ADM --> CU12
COO --> CU12

CU12 ..> CUI3 : <<include>>

CUE5 ..> CU12 : <<extend>>\n[el rol no alcanza ese dato]

@enduml
