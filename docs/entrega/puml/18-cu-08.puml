@startuml 18-cu-08
' CU-08 · Registrar una atención social y sus gestiones — caso de uso detallado.
' El caso con su actor, sus casos incluidos y sus casos de extensión.
' La explicación de cada paso va en la FICHA, no en el diagrama: la
' rúbrica §5.4 pide el detalle en la ficha textual (casos-uso-detalle.md).
title CU-08 · Registrar una atención social y sus gestiones

skinparam backgroundColor #F4F4F2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #5B6166
skinparam ArrowFontColor #5B6166
skinparam ArrowFontSize 11
skinparam actorStyle awesome
skinparam actor {
  BackgroundColor #EFEDE8
  BorderColor #5B6166
  FontColor #1A1A1A
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #B9BDBF
  FontColor #1A1A1A
}
skinparam rectangle {
  BackgroundColor #FAFAF8
  BorderColor #B9BDBF
  FontColor #5B6166
}

actor "Funcionario" as FUN

rectangle "**SGR** — M2 · Registro personal y evidencias" #FFFFFF {
  usecase "CU-08\nRegistrar una atención\nsocial y sus gestiones" as CU08
  usecase "CU-I3\nRegistrar en la bitácora\nde auditoría" as CUI3
}

FUN --> CU08

CU08 ..> CUI3 : <<include>>

@enduml
