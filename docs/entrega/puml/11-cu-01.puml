@startuml 11-cu-01
' CU-01 · Registrar actividad diaria — caso de uso detallado.
' El caso con su actor, sus casos incluidos y sus casos de extensión.
' La explicación de cada paso va en la FICHA, no en el diagrama: la
' rúbrica §5.4 pide el detalle en la ficha textual (casos-uso-detalle.md).
title CU-01 · Registrar actividad diaria

skinparam backgroundColor #F4F4F2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #5B6166
skinparam ArrowFontColor #5B6166
skinparam ArrowFontSize 11
skinparam actorStyle awesome
skinparam actor {
  BackgroundColor #EFEDE8
  BorderColor #5B6166
  FontColor #1A1A1A
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #B9BDBF
  FontColor #1A1A1A
}
skinparam rectangle {
  BackgroundColor #FAFAF8
  BorderColor #B9BDBF
  FontColor #5B6166
}

actor "Funcionario" as FUN

rectangle "**SGR** — M2 · Registro personal y evidencias" #FFFFFF {
  usecase "CU-01\nRegistrar actividad diaria" as CU01
  usecase "CU-E1\nAvisar posible\natención duplicada" as CUE1
  usecase "CU-I1\nValidar los datos\ndel registro" as CUI1
  usecase "CU-I2\nGenerar el código único\nde la actividad" as CUI2
  usecase "CU-I3\nRegistrar en la bitácora\nde auditoría" as CUI3
}

FUN --> CU01

CU01 ..> CUI1 : <<include>>
CU01 ..> CUI2 : <<include>>
CU01 ..> CUI3 : <<include>>

CUE1 ..> CU01 : <<extend>>\n[el vecino ya registra\natenciones en otra delegación]

@enduml
