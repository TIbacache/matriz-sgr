@startuml 16-cu-06
' CU-06 · Registrar un compromiso del vecino en el tubo — caso de uso detallado.
' El caso con su actor, sus casos incluidos y sus casos de extensión.
' La explicación de cada paso va en la FICHA, no en el diagrama: la
' rúbrica §5.4 pide el detalle en la ficha textual (casos-uso-detalle.md).
title CU-06 · Registrar un compromiso del vecino en el tubo

skinparam backgroundColor #F4F4F2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #5B6166
skinparam ArrowFontColor #5B6166
skinparam ArrowFontSize 11
skinparam actorStyle awesome
skinparam actor {
  BackgroundColor #EFEDE8
  BorderColor #5B6166
  FontColor #1A1A1A
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #B9BDBF
  FontColor #1A1A1A
}
skinparam rectangle {
  BackgroundColor #FAFAF8
  BorderColor #B9BDBF
  FontColor #5B6166
}

actor "Funcionario" as FUN
actor "Delegado\no jefatura" as DEL

rectangle "**SGR** — M3 · Agenda colectiva" #FFFFFF {
  usecase "CU-06\nRegistrar un compromiso\ndel vecino en el tubo" as CU06
  usecase "CU-E1\nAvisar posible\natención duplicada" as CUE1
  usecase "CU-I1\nValidar los datos\ndel registro" as CUI1
  usecase "CU-I3\nRegistrar en la bitácora\nde auditoría" as CUI3
}

FUN --> CU06
DEL --> CU06

CU06 ..> CUI1 : <<include>>
CU06 ..> CUI3 : <<include>>

CUE1 ..> CU06 : <<extend>>\n[el vecino ya registra atenciones\no compromisos en otra delegación]

@enduml
