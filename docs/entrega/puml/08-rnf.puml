@startuml rnf
' Los 18 requerimientos no funcionales, agrupados por atributo de calidad
title Requerimientos no funcionales (18)

skinparam backgroundColor #F4F4F2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #5B6166
skinparam ArrowFontColor #5B6166
skinparam ArrowFontSize 11
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #B9BDBF
  FontColor #1A1A1A
}


rectangle "**Seguridad y privacidad**" as SEG #EFEDE8
rectangle "**Operación y capacidad**" as OPE #EFEDE8
rectangle "**Integridad de los datos**" as DAT #EFEDE8
rectangle "**Experiencia de uso**" as EXP #EFEDE8
rectangle "**Evolución**" as EVO #EFEDE8

rectangle "<<requirement>>\n**RNF-004**\nAutenticación con\nidentidad individual" as RNF004
rectangle "<<requirement>>\n**RNF-005**\nAutorización con mínimo\nprivilegio y segregación" as RNF005
rectangle "<<requirement>>\n**RNF-006**\nConfidencialidad y cifrado\nen tránsito\n//parcial//" as RNF006
rectangle "<<requirement>>\n**RNF-008**\nAuditoría con valor\nanterior y nuevo\n//parcial//" as RNF008
rectangle "<<requirement>>\n**RNF-009**\nPrivacidad y minimización\nde datos personales\n//pendiente//" as RNF009 #FFFFFF;line.dashed

rectangle "<<requirement>>\n**RNF-001**\nDisponibilidad 99,5%\n//pendiente//" as RNF001 #FFFFFF;line.dashed
rectangle "<<requirement>>\n**RNF-002**\nRendimiento 2 s en registro\ny 5 s en tableros\n//parcial//" as RNF002
rectangle "<<requirement>>\n**RNF-003**\nConcurrencia sin\nsobrescritura silenciosa\n//parcial//" as RNF003
rectangle "<<requirement>>\n**RNF-014**\nEscalabilidad sin\nrediseñar" as RNF014
rectangle "<<requirement>>\n**RNF-018**\nMonitoreo con métricas\ny alertas\n//pendiente//" as RNF018 #FFFFFF;line.dashed

rectangle "<<requirement>>\n**RNF-007**\nIntegridad de formatos\ny relaciones\n//parcial//" as RNF007
rectangle "<<requirement>>\n**RNF-010**\nRespaldo con RPO 24 h\ny RTO 4 h\n//pendiente//" as RNF010 #FFFFFF;line.dashed
rectangle "<<requirement>>\n**RNF-017**\nGestión de evidencias\ny retención\n//parcial//" as RNF017

rectangle "<<requirement>>\n**RNF-011**\nUsabilidad para quien\nno maneja planillas" as RNF011
rectangle "<<requirement>>\n**RNF-012**\nAccesibilidad por teclado\ny contraste\n//parcial//" as RNF012
