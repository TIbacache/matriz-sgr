@startuml 21-cu-11
' CU-11 · Buscar el historial de un vecino entre delegaciones — caso de uso detallado.
' El caso con su actor, sus casos incluidos y sus casos de extensión.
' La explicación de cada paso va en la FICHA, no en el diagrama: la
' rúbrica §5.4 pide el detalle en la ficha textual (casos-uso-detalle.md).
title CU-11 · Buscar el historial de un vecino entre delegaciones

skinparam backgroundColor #F4F4F2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #5B6166
skinparam ArrowFontColor #5B6166
skinparam ArrowFontSize 11
skinparam actorStyle awesome
skinparam actor {
  BackgroundColor #EFEDE8
  BorderColor #5B6166
  FontColor #1A1A1A
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #B9BDBF
  FontColor #1A1A1A
}
skinparam rectangle {
  BackgroundColor #FAFAF8
  BorderColor #B9BDBF
  FontColor #5B6166
}

actor "Funcionario" as FUN
actor "Coordinador\ndel sistema" as COO

rectangle "**SGR** — M5 · Consulta y trazabilidad" #FFFFFF {
  usecase "CU-11\nBuscar el historial de un\nvecino entre delegaciones" as CU11
  usecase "CU-E1\nAvisar posible\natención duplicada" as CUE1
  usecase "CU-E5\nDenegar por alcance\ncon el motivo escrito" as CUE5
  usecase "CU-I3\nRegistrar en la bitácora\nde auditoría" as CUI3
}

FUN --> CU11
COO --> CU11

CU11 ..> CUI3 : <<include>>

CUE1 ..> CU11 : <<extend>>\n[dos hechos de la misma clasificación\ndentro de la ventana de duplicidad]
CUE5 ..> CU11 : <<extend>>\n[el rol no alcanza ese dato]

@enduml
