@startuml 13-cu-03
' CU-03 · Validar o rechazar una evidencia — caso de uso detallado.
' El caso con su actor, sus casos incluidos y sus casos de extensión.
' La explicación de cada paso va en la FICHA, no en el diagrama: la
' rúbrica §5.4 pide el detalle en la ficha textual (casos-uso-detalle.md).
title CU-03 · Validar o rechazar una evidencia

skinparam backgroundColor #F4F4F2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #5B6166
skinparam ArrowFontColor #5B6166
skinparam ArrowFontSize 11
skinparam actorStyle awesome
skinparam actor {
  BackgroundColor #EFEDE8
  BorderColor #5B6166
  FontColor #1A1A1A
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #B9BDBF
  FontColor #1A1A1A
}
skinparam rectangle {
  BackgroundColor #FAFAF8
  BorderColor #B9BDBF
  FontColor #5B6166
}

actor "Verificador" as VER

rectangle "**SGR** — M2 · Registro personal y evidencias" #FFFFFF {
  usecase "CU-03\nValidar o rechazar\nuna evidencia" as CU03
  usecase "CU-E2\nExigir observación\nde la decisión" as CUE2
  usecase "CU-E3\nRechazar la\nvalidación propia" as CUE3
  usecase "CU-I3\nRegistrar en la bitácora\nde auditoría" as CUI3
}

VER --> CU03

CU03 ..> CUI3 : <<include>>

CUE2 ..> CU03 : <<extend>>\n[la decisión no es aprobar]
CUE3 ..> CU03 : <<extend>>\n[quien valida es quien registró]

@enduml
